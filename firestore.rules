rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsArchive(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /archives/{uid}/fragments/{fragment} {
      allow read: if ownsArchive(uid);
      allow create, update: if ownsArchive(uid)
        && request.resource.data.id is string
        && request.resource.data.bucket in ['saved', 'archived', 'deleted']
        && request.resource.data.updatedAt is number
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 0
        && request.resource.data.chunkCount <= 12
        && request.resource.data.imageHeader is string;

      match /image/{part} {
        allow get, delete: if ownsArchive(uid);
        allow create, update: if ownsArchive(uid)
          && request.resource.data.keys().hasOnly(['bytes'])
          && request.resource.data.bytes is bytes
          && request.resource.data.bytes.size() <= 700000;
      }
    }
  }
}
