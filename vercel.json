{
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://commentorchive.firebaseapp.com/__/auth/:path*"
    }
  ]
}
